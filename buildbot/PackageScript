import os

builder.SetBuildFolder('package')

builder.AddFolder('addons')
builder.AddFolder(os.path.join('addons', 'sourcemod'))
extensions = builder.AddFolder(os.path.join('addons', 'sourcemod', 'extensions'))
gamedata = builder.AddFolder(os.path.join('addons', 'sourcemod', 'gamedata'))
configs = builder.AddFolder(os.path.join('addons', 'sourcemod', 'configs'))
scripting = builder.AddFolder(os.path.join('addons', 'sourcemod', 'scripting'))
include = builder.AddFolder(os.path.join('addons', 'sourcemod', 'scripting', 'include'))

extensions_x64 = None
for cxx in Extension.targets:
  if cxx.target.arch == 'x86_64':
    extensions_x64 = builder.AddFolder(os.path.join('addons', 'sourcemod', 'extensions', 'x64'))
    break

builder.AddCopy(os.path.join(builder.sourcePath, 'tf2items.autoload'), extensions)
builder.AddCopy(os.path.join(builder.sourcePath, 'tf2.items.txt'), gamedata)
builder.AddCopy(os.path.join(builder.sourcePath, 'tf2items.weapons.example.txt'), configs)
builder.AddCopy(os.path.join(builder.sourcePath, 'pawn', 'tf2items_manager.sp'), scripting)
builder.AddCopy(os.path.join(builder.sourcePath, 'pawn', 'tf2items.inc'), include)

for task in Extension.binaries:
  if task.target.arch == 'x86_64':
    builder.AddCopy(task.binary, extensions_x64)
  else:
    builder.AddCopy(task.binary, extensions)
